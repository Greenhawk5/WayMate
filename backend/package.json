{
  "name": "waymate-backend",
  "version": "1.0.0",
  "description": "WayMate Cloudflare Workers edge backend API with D1 database",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/node": "^26.6.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^4.151.1"
  }
}
