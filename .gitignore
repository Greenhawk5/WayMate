# ==============================================================================
# WayMate Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Android & Gradle Build Artifacts
# ------------------------------------------------------------------------------
.gradle/
build/
**/build/
*.apk
*.aab
*.dex
.kotlin/
*.kotlin_module
.externalNativeBuild/
.cxx/
hs_err_pid*

# ------------------------------------------------------------------------------
# 2. Android Studio / IntelliJ IDEA
# (Preserve team-shared configs: compiler.xml, misc.xml, gradle.xml, etc.)
# ------------------------------------------------------------------------------
*.iml
.idea/workspace.xml
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetSelector.xml
.idea/deploymentTargetDropDown.xml
.idea/render.experimental.xml
.idea/vcs.xml
.idea/shelf/
*.iws

# ------------------------------------------------------------------------------
# 3. Local Machine Configuration, Signing & Secrets
# ------------------------------------------------------------------------------
local.properties
keystore.properties
key.properties
secrets.properties
*.jks
*.keystore
.env*
backend/.dev.vars

# ------------------------------------------------------------------------------
# 4. Testing, Visual Captures & Diagnostics
# ------------------------------------------------------------------------------
/current_screen.png
/screen*.png
/captures/
*.hprof
*.logcat
/docs/device-screenshots/
/docs/device_screenshots/

# ------------------------------------------------------------------------------
# 5. Local Scratch, Design Sources & External References
# ------------------------------------------------------------------------------
/Atak project/
/temp/
/app/src/icon/
todo.md

# ------------------------------------------------------------------------------
# 6. Backend (Cloudflare Workers) & Node.js
# ------------------------------------------------------------------------------
node_modules/
backend/node_modules/
.wrangler/
backend/.wrangler/
backend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------------------------------------------
# 7. OS & Editor Metadata
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
