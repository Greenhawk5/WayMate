<?xml version="1.0" encoding="utf-8"?>
<!--
    WayMate Local Development Network Security Configuration.
    Strictly scoped to local development loops (emulator host and adb reverse / localhost).
    Does NOT permit cleartext traffic to arbitrary or public internet domains.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
