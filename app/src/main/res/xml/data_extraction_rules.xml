<?xml version="1.0" encoding="utf-8"?>
<!--
   WayMate Data Extraction Rules (Android 12+ / API 31+)
   Excludes sensitive cryptographic keys, authentication tokens, and cached operational data
   from cloud backup and device transfer to prevent offline credential theft and replay.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="waymate_secure_session.xml"/>
        <exclude domain="database" path="waymate_offline.db"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="waymate_secure_session.xml"/>
        <exclude domain="database" path="waymate_offline.db"/>
    </device-transfer>
</data-extraction-rules>
